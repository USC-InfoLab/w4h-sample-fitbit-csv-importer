# Copy to `.env` and fill in locally. Never commit `.env`.

# W4H API base URL (no trailing path beyond /api if using nginx proxy use full api origin)
W4H_API_BASE=http://localhost:2026

# Personal API key from Profile → API keys (w4h_sk_…)
W4H_API_KEY=

# Optional: path to sibling sample package (clone w4h-sample-fitbit-csv next to this repo)
W4H_SAMPLE_FITBIT_CSV_PATH=../w4h-sample-fitbit-csv

# Import target (create empty dataset in Admin UI first, or let import create catalog row)
W4H_DATASET_ID=sample-fitbit-csv
W4H_TEAM_ID=
